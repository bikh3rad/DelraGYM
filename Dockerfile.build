# Dockerfile for building Delara Android APK
# Usage:
#   docker build -t delara-builder -f Dockerfile.build .
#   docker run --rm -v $(pwd)/output:/output delara-builder
#
# The APK is copied to /output/delara-debug.apk

FROM node:20-slim AS frontend-builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY catalogue/ ../catalogue/
RUN npm run build
RUN mkdir -p dist/exercise-media/still dist/exercise-media/clip && \
    cp ../catalogue/media/still/*.webp dist/exercise-media/still/ && \
    cp ../catalogue/media/clip/*.mp4 dist/exercise-media/clip/

FROM thyrlian/android-sdk:latest AS android-builder
WORKDIR /app
RUN apt-get update && apt-get install -y nodejs npm && rm -rf /var/lib/apt/lists/*
COPY --from=frontend-builder /app/dist ./dist
COPY --from=frontend-builder /app/node_modules ./node_modules
COPY --from=frontend-builder /app/package.json ./
COPY frontend/android ./android
COPY frontend/capacitor.config.json ./
COPY frontend/scripts ./scripts
RUN npx cap sync android
RUN cd android && chmod +x gradlew && ./gradlew assembleDebug

FROM scratch
COPY --from=android-builder /app/android/app/build/outputs/apk/debug/app-debug.apk /delara-debug.apk
