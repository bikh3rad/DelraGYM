# Delara — تنظیمات پیش‌فرض برای اجرای محلی
# این فایل را برای deployment واقعی ویرایش کنید

# دامنه و پورت (برای localhost همین مقادیر را نگه دارید)
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=دلارا

# پورت API
PORT=3000

# زبان پیش‌فرض (فارسی)
DEFAULT_LANG=fa

# اعتماد به پروکسی (برای docker compose)
TRUST_PROXY=1
